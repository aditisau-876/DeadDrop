APP_NAME=DeadDrop
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/deaddrop

BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337

# Set this to the deployed DeadDrop contract address before using EIP-712 signatures.
BLOCKCHAIN_VERIFYING_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Authentication
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-48-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOW_PUBLIC_REGISTRATION=true
